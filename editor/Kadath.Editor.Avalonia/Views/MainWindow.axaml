<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kadath.Editor.Avalonia.Views.MainWindow"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        Title="Kadath Editor · 行为脚本源码编辑">
  <Grid RowDefinitions="Auto,*,220" Background="#15191F">
    <Border Grid.Row="0" Padding="12,8" Background="#20262E" BorderBrush="#3C4652" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Kadath Editor" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#AEBAC8" Text="P2-Editor-Behavior-Script-Asset-Lifecycle-01 · Luau 脚本资产" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#AEBAC8" Text="{Binding ConnectionStatus}" />
        <Button Grid.Column="3" Padding="14,5" Command="{Binding ConnectCommand}" Content="连接 Service" />
        <Button Grid.Column="4" Padding="14,5" Command="{Binding OpenProjectCommand}" Content="打开项目" />
        <Button Grid.Column="5" Padding="14,5" Command="{Binding CreateProjectCommand}" Content="新建项目" />
        <Button Grid.Column="6" Padding="14,5" Command="{Binding ValidateProjectCommand}" Content="校验" />
        <Button Grid.Column="7" Padding="14,5" Command="{Binding RefreshSnapshotsCommand}" Content="刷新快照" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="270,*,390" ColumnSpacing="1">
      <Border Grid.Column="0" Padding="12" Background="#1C222A" BorderBrush="#323B46" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
          <TextBlock FontWeight="SemiBold" Text="Project" />
          <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock FontSize="11" Foreground="#8F9CAB" Text="Package root" />
            <TextBox Text="{Binding PackageRoot}" PlaceholderText="Kadath package root" />
            <TextBlock FontSize="11" Foreground="#8F9CAB" Text="Project name" />
            <TextBox Text="{Binding ProjectName}" PlaceholderText="project name" />
          </StackPanel>
          <TabControl Grid.Row="2" Margin="0,8,0,0">
            <TabItem Header="Hierarchy">
              <ListBox ItemsSource="{Binding HierarchyItems}" SelectedItem="{Binding SelectedHierarchyItem}" />
            </TabItem>
            <TabItem Header="Assets">
              <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
                <ListBox ItemsSource="{Binding AssetItems}" SelectedItem="{Binding SelectedAssetItem}" />
                <Border Grid.Row="1" Padding="8" Background="#252D37" CornerRadius="4">
                  <StackPanel Spacing="5">
                    <TextBlock FontWeight="SemiBold" Text="导入纹理" />
                    <TextBox Text="{Binding TextureImportSourcePath}" PlaceholderText="外部 .png / .ppm 源路径" />
                    <TextBox Text="{Binding TextureImportAssetName}" PlaceholderText="资产名，例如 imported.texture" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <ComboBox ItemsSource="{Binding TextureImportProfiles}" SelectedItem="{Binding TextureImportProfile}" />
                      <Button Grid.Column="1" Command="{Binding ImportTextureCommand}" Content="导入" />
                    </Grid>
                    <TextBlock FontSize="11" Foreground="#9FE3B1" Text="{Binding TextureImportStatus}" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="#AEBAC8" Text="{Binding TextureImportDetails}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="2" Padding="8" Background="#252D37" CornerRadius="4">
                  <StackPanel Spacing="5">
                    <TextBlock FontWeight="SemiBold" Text="行为脚本资产" />
                    <TextBox Text="{Binding ScriptAssetPath}" PlaceholderText="scripts/new_behavior.luau" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                      <Button Grid.Row="0" Grid.Column="0" Command="{Binding CreateScriptAssetCommand}" Content="新建脚本" />
                      <Button Grid.Row="0" Grid.Column="1" Command="{Binding RenameScriptAssetCommand}" Content="重命名当前" />
                      <Button Grid.Row="1" Grid.Column="0" Command="{Binding DeleteScriptAssetCommand}" Content="删除当前" />
                      <Button Grid.Row="1" Grid.Column="1" Command="{Binding UndoScriptAssetCommand}" Content="撤销资产操作" />
                    </Grid>
                    <TextBlock FontSize="11" Foreground="#D7B46A" Text="{Binding ScriptAssetLifecycleStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>
          </TabControl>
          <Border Grid.Row="3" Padding="8" Background="#252D37" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="Validation" />
              <TextBlock Foreground="#9FE3B1" Text="{Binding ValidationStatus}" />
              <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding ValidationDiagnostics}" />
              <TextBlock FontSize="11" Foreground="#AEBAC8" TextWrapping="Wrap" Text="{Binding SnapshotStatus}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Margin="12" Background="#0D1014" BorderBrush="#3C4652" BorderThickness="1" CornerRadius="5">
        <Grid RowDefinitions="Auto,*,Auto" Margin="14">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Preview Surface" />
            <Button Grid.Column="1" Command="{Binding StartPreviewCommand}" Content="Start" />
            <Button Grid.Column="2" Command="{Binding StopPreviewCommand}" Content="Stop" />
          </Grid>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock HorizontalAlignment="Center" FontSize="26" Foreground="#8593A3" Text="Runtime 独立窗口" />
            <TextBlock HorizontalAlignment="Center" Foreground="#AEBAC8" Text="v1 external-window · no pixel frames over RPC" />
            <TextBlock HorizontalAlignment="Center" Foreground="#6DD6A0" Text="{Binding PreviewStatus}" />
            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#8F9CAB" Text="{Binding SurfaceDetails}" />
            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#D7B46A" Text="{Binding RuntimeSyncStatus}" />
          </StackPanel>
          <Border Grid.Row="2" Padding="8" Background="#20262E">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="Surface mode" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#AEBAC8" Text="{Binding SurfaceMode}" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#8F9CAB" Text="{Binding CapabilitySummary}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Padding="12" Background="#1C222A" BorderBrush="#323B46" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Inspector / Authoring" />
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">
              <Border Padding="8" Background="#20262E" CornerRadius="4">
                <TextBlock TextWrapping="Wrap" Foreground="#C3CEDA" Text="{Binding InspectorText}" />
              </Border>

              <Border IsVisible="{Binding HasSelectedScriptDependency}" Padding="8" Background="#252D37" CornerRadius="4">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold" Text="行为脚本源码" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#AEBAC8" Text="Luau · UTF-8" />
                  </Grid>
                  <TextBlock FontSize="11" Foreground="#9FE3B1" Text="{Binding ScriptSourcePath}" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" Foreground="#AEBAC8" Text="{Binding ScriptSourceRevisionStatus}" />
                  <TextBox MinHeight="260"
                           AcceptsReturn="True"
                           FontFamily="Consolas"
                           FontSize="12"
                           IsEnabled="{Binding CanEditScriptSourceBuffer}"
                           CaretIndex="{Binding ScriptSourceCaretIndex, Mode=TwoWay}"
                           Text="{Binding ScriptSourceText}"
                           TextWrapping="NoWrap"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" />
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Command="{Binding SaveScriptSourceCommand}" Content="保存源码" />
                    <Button Command="{Binding UndoScriptSourceCommand}" Content="撤销提交" />
                    <Button Command="{Binding ReloadScriptSourceCommand}" Content="重新读取" />
                    <Button Command="{Binding DiscardScriptSourceChangesCommand}" Content="放弃修改" />
                    <Button Command="{Binding ReanalyzeScriptSourceCommand}" Content="重新分析" />
                  </StackPanel>
                  <TextBlock FontSize="11" Foreground="#D7B46A" Text="{Binding ScriptSourceStatus}" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" Foreground="#9FE3B1" Text="{Binding ScriptDiagnosticsStatus}" TextWrapping="Wrap" />
                  <ListBox MaxHeight="180"
                           IsVisible="{Binding HasScriptDiagnostics}"
                           ItemsSource="{Binding ScriptDiagnostics}"
                           SelectedItem="{Binding SelectedScriptDiagnostic}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding DisplayText}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <Border Padding="8" Background="#252D37" CornerRadius="4">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold" Text="Scene Objects" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#AEBAC8" Text="{Binding SceneObjectCountStatus}" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding SceneObjectDrafts}" SelectedItem="{Binding SelectedSceneObject}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Command="{Binding AddDecorativeSpriteCommand}" Content="+ Sprite" />
                    <Button Command="{Binding AddPatrolHazardCommand}" Content="+ Hazard" />
                    <Button Command="{Binding DeleteSceneObjectCommand}" Content="删除" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Command="{Binding MoveSceneObjectUpCommand}" Content="上移" />
                    <Button Command="{Binding MoveSceneObjectDownCommand}" Content="下移" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#8F9CAB" Text="source order = draw order" />
                  </StackPanel>

                  <Border IsVisible="{Binding HasSelectedSceneObject}" Padding="7" Background="#1C222A" CornerRadius="4">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock VerticalAlignment="Center" Text="ObjectId" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedSceneObject.ObjectId}" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock VerticalAlignment="Center" Text="Kind" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#9FE3B1" Text="{Binding SelectedSceneObject.Kind}" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">
                        <TextBlock VerticalAlignment="Center" Text="Pos X" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedSceneObject.PositionX}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Y" />
                        <TextBox Grid.Column="3" Text="{Binding SelectedSceneObject.PositionY}" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">
                        <TextBlock VerticalAlignment="Center" Text="Size X" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedSceneObject.SizeX}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Y" />
                        <TextBox Grid.Column="3" Text="{Binding SelectedSceneObject.SizeY}" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" ColumnSpacing="3">
                        <TextBlock VerticalAlignment="Center" Text="R" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedSceneObject.ColorR}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="G" />
                        <TextBox Grid.Column="3" Text="{Binding SelectedSceneObject.ColorG}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="B" />
                        <TextBox Grid.Column="5" Text="{Binding SelectedSceneObject.ColorB}" />
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="A" />
                        <TextBox Grid.Column="7" Text="{Binding SelectedSceneObject.ColorA}" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock VerticalAlignment="Center" Text="TextureId" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SelectedSceneObject.TextureIds}" SelectedItem="{Binding SelectedSceneObject.TextureIdText}" />
                      </Grid>
                      <Grid IsVisible="{Binding SelectedSceneObject.IsPlayer}" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock VerticalAlignment="Center" Text="Move speed" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedSceneObject.MoveSpeed}" />
                      </Grid>
                      <Grid IsVisible="{Binding SelectedSceneObject.UsesNativePatrol}" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="3">
                        <TextBlock VerticalAlignment="Center" Text="Min Y" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedSceneObject.PatrolMinY}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Max Y" />
                        <TextBox Grid.Column="3" Text="{Binding SelectedSceneObject.PatrolMaxY}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Speed" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSceneObject.PatrolSpeed}" />
                      </Grid>
                      <Border IsVisible="{Binding UsesBehaviorBindingAuthoring}" Padding="7" Background="#252D37" CornerRadius="4">
                        <StackPanel Spacing="5">
                          <TextBlock FontWeight="SemiBold" Text="行为脚本绑定" />
                          <TextBlock FontSize="11" Foreground="#AEBAC8" Text="{Binding BehaviorContractStatus}" TextWrapping="Wrap" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                            <ComboBox ItemsSource="{Binding AvailableBehaviorContracts}" SelectedItem="{Binding SelectedBehaviorContract}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding SourcePath}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Command="{Binding AddBehaviorBindingCommand}" Content="添加绑定" />
                          </Grid>
                          <ListBox MaxHeight="110" ItemsSource="{Binding SelectedSceneObject.Behaviors}" SelectedItem="{Binding SelectedBehaviorBinding}">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button Command="{Binding RemoveBehaviorBindingCommand}" Content="移除" />
                            <Button Command="{Binding MoveBehaviorBindingUpCommand}" Content="上移" />
                            <Button Command="{Binding MoveBehaviorBindingDownCommand}" Content="下移" />
                          </StackPanel>
                          <TextBlock IsVisible="{Binding HasSelectedBehaviorBinding}" FontSize="11" Foreground="#9FE3B1" Text="{Binding SelectedBehaviorBinding.Status}" />
                          <ItemsControl IsEnabled="{Binding IsBehaviorContractReady}" ItemsSource="{Binding SelectedBehaviorBinding.Parameters}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" Margin="0,0,0,4">
                                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                  <TextBox Grid.Column="1" PlaceholderText="留空使用默认值" Text="{Binding ValueText}" />
                                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="10" Foreground="#8F9CAB" Text="{Binding Details}" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Padding="8" Background="#252D37" CornerRadius="4">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="SemiBold" Text="Scene texture set" />
                  <ItemsControl ItemsSource="{Binding SceneTextureAssignments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,68,Auto,*" ColumnSpacing="4" Margin="0,0,0,4">
                          <TextBlock VerticalAlignment="Center" Text="{Binding SlotLabel}" />
                          <TextBox Grid.Column="1" Text="{Binding TextureIdText}" />
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Asset" />
                          <ComboBox Grid.Column="3" ItemsSource="{Binding AssetItems}" SelectedItem="{Binding SelectedAssetItem}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding UsesHookScriptAuthoring}" Padding="8" Background="#252D37" CornerRadius="4">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="SemiBold" Text="Script Goal" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="3">
                    <TextBlock VerticalAlignment="Center" Text="Pos X" />
                    <TextBox Grid.Column="1" Text="{Binding ScriptGoalX}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Y" />
                    <TextBox Grid.Column="3" Text="{Binding ScriptGoalY}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Vel X" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScriptVelocityX}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Y" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ScriptVelocityY}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Padding="8" Background="#252D37" CornerRadius="4">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Text="Authoring · optimistic revision" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding ApplyAuthoringCommand}" Content="Apply Objects" />
                    <Button Command="{Binding UndoAuthoringCommand}" Content="Undo" />
                  </StackPanel>
                  <TextBlock Foreground="#AEBAC8" Text="{Binding AuthoringStatus}" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" Foreground="#AEBAC8" Text="{Binding AuthoringRevisionStatus}" />
                </StackPanel>
              </Border>

              <Border Padding="8" Background="#252D37" CornerRadius="4">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Text="Capability gating" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontSize="11" Text="external-window" />
                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding SupportsExternalWindow}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontSize="11" Text="shared-texture" />
                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding SupportsSharedTexture}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontSize="11" Text="frame-stream" />
                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding SupportsFrameStream}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="12,8" Background="#20262E" BorderBrush="#3C4652" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Bake / Watch" />
          <ComboBox Grid.Column="1" Width="105" ItemsSource="{Binding BakeTargets}" SelectedItem="{Binding BakeTarget}" />
          <ComboBox Grid.Column="2" Width="105" ItemsSource="{Binding BakeProfiles}" SelectedItem="{Binding BakeProfile}" />
          <Button Grid.Column="3" Command="{Binding BakeCommand}" Content="Bake once" />
          <Button Grid.Column="4" Command="{Binding BakeChangesCommand}" Content="Bake Changes" />
          <Button Grid.Column="5" Command="{Binding StartWatchCommand}" Content="Start watch" />
          <Button Grid.Column="6" Command="{Binding StopWatchCommand}" Content="Stop watch" />
          <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14">
            <CheckBox IsChecked="{Binding LiveBakeEnabled}" Content="Live Bake" />
            <CheckBox IsChecked="{Binding WatchChanges}" Content="Preview Watch" />
          </StackPanel>
          <StackPanel Grid.Column="8" VerticalAlignment="Center" Spacing="2">
            <TextBlock Foreground="#9FE3B1" Text="{Binding BakeStatus}" />
            <TextBlock Foreground="#AEBAC8" FontSize="11" Text="{Binding PublicationStatus}" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <ListBox ItemsSource="{Binding EventLog}" Background="#11151A">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock FontFamily="Consolas" FontSize="11" Text="[" />
                  <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Sequence}" />
                  <TextBlock FontFamily="Consolas" FontSize="11" Text="]" />
                  <TextBlock FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Text="{Binding Event}" />
                  <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Summary}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Column="1" VerticalAlignment="Top" Foreground="#AEBAC8" FontSize="11" Text="{Binding PublicationStatus}" />
          <Button Grid.Column="2" VerticalAlignment="Top" Command="{Binding ClearEventLogCommand}" Content="Clear log" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
